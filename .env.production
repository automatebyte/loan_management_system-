# Production Environment Variables
DEBUG=False
SECRET_KEY=GENERATE_SECURE_KEY_IN_RENDER
ALLOWED_HOSTS=.onrender.com,kreditai.com

# Database
DATABASE_URL=postgresql://user:pass@host:port/kreditai_db

# Redis
REDIS_URL=redis://redis:6379/0

# Email
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SENDGRID_API_KEY
DEFAULT_FROM_EMAIL=noreply@kreditai.com

# Frontend
REACT_APP_API_URL=https://kreditai-backend.onrender.com

# Security
CORS_ALLOWED_ORIGINS=https://kreditai.onrender.com
CSRF_TRUSTED_ORIGINS=https://kreditai.onrender.com